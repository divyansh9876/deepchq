# Copy to .env.local for local dev:  cp .env.example .env.local
# Full guide: docs/ENV-SETUP.md

# Required — public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required — JSON database file path
DATABASE_URL=file:./data/deepchq.json

# Dev: unlock reports without payment. Production: false
ALLOW_DEV_UNLOCK=true

# Optional — real Google search results (https://serper.dev)
SERPER_API_KEY=

# Razorpay — https://dashboard.razorpay.com/app/keys
# NEXT_PUBLIC_* is the same Key ID as RAZORPAY_KEY_ID (safe for the browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Recurring plans (create via: npx tsx scripts/razorpay/create-plans.ts)
RAZORPAY_PLAN_BASIC_WEEKLY=
RAZORPAY_PLAN_BASIC_QUARTERLY=
RAZORPAY_PLAN_BASIC_YEARLY=
RAZORPAY_PLAN_PRO_WEEKLY=
RAZORPAY_PLAN_PRO_QUARTERLY=
RAZORPAY_PLAN_PRO_YEARLY=

# Set false to force one-time checkout only
# RAZORPAY_USE_SUBSCRIPTIONS=true

# Admin analytics dashboard (/admin/analytics)
ANALYTICS_SECRET=

# Google Sign-In — https://console.cloud.google.com/apis/credentials
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved / future
OPENAI_API_KEY=
APPLE_CLIENT_ID=
