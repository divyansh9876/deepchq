# ---- Core ----
DATABASE_URL=file:./data/deepchq.json
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random chars. Required in production:  openssl rand -base64 48
SESSION_SECRET=

# ---- Automation ----
# Protects POST /api/cron/run for an external scheduler (optional when the internal scheduler is on)
CRON_SECRET=
# The in-process scheduler runs in production by default. Set "true" to also run it in dev.
ENABLE_INTERNAL_CRON=
CRON_INTERVAL_MINUTES=30

# ---- Live AI engines (each is optional; engines without a key are shown as "Estimated") ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Email via Resend (welcome, digests, trial + billing notices, lead alerts) ----
RESEND_API_KEY=
EMAIL_FROM="Deepchq <hello@yourdomain.com>"
ADMIN_EMAIL=

# ---- Billing via Razorpay subscriptions ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_GROWTH_ANNUAL=
RAZORPAY_PLAN_AGENCY_MONTHLY=
RAZORPAY_PLAN_AGENCY_ANNUAL=

# ---- SEO ----
# Comma-separated official profile URLs for Organization schema (LinkedIn, X, Crunchbase, G2…)
NEXT_PUBLIC_SAME_AS=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
